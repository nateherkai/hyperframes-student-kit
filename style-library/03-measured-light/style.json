{
  "$schema": "../registry.schema.json",
  "id": "measured-light",
  "name": "Measured Light",
  "number": "03",
  "status": "draft",
  "inspiration": "No sale de una referencia visual: sale de medir 40 piezas contra 22 referencias reales. Las reglas están en references/lecciones-medidas.md.",
  "summary": "Registro claro, un objeto por cuadro, el color estrictamente en los objetos y nunca en la tipografía. Para producto, precio y promesa.",
  "palette": {
    "bg": "#F3F4F9",
    "fg": "#0A0A14",
    "accent": "#1D1DE8",
    "notes": "Papel nunca blanco puro: un campo plano no da rango tonal y la medición se desploma. El acento no toca el texto."
  },
  "fonts": {
    "display": "Instrument Sans",
    "body": "Instrument Sans",
    "mono": "IBM Plex Mono"
  },
  "motion": "Entradas power2.out de 0,5-0,7 s · golpes back.out(2.4) · salidas más rápidas que las entradas. Cámara calculada: recorrido_px / duracion_s >= 60.",
  "transitions": "Atravesar con zoom: la que sale se agranda y se desenfoca, la que entra llega chica y nítida, con 0,12 s de solape.",
